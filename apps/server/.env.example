# Copy this file to .env.local (git-ignored) and fill in your keys. The server reads it on start.

# Required: https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Trending scams summary, tried in this order. Any one is enough; a blank key is skipped.
# https://console.groq.com/keys
GROQ_API_KEY=
# Optional second OpenAI-compatible provider, e.g. OpenRouter or OpenAI
LLM2_NAME=
LLM2_BASE_URL=
LLM2_API_KEY=
LLM2_MODELS=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Lets you trigger a trending refresh by hand: POST /v1/trending/refresh with X-Refresh-Token
TRENDING_REFRESH_TOKEN=
