{
  "region": "in",
  "patterns": [
    {
      "id": "apk-file",
      "name": "Fake app file",
      "summary": "A WhatsApp message sends an .apk file disguised as a traffic challan, wedding invite, bank app or bill. Installing it lets scammers read your OTPs and take over your accounts.",
      "points": 35,
      "phrases": {
        "strong": [
          ".apk",
          "challan.apk",
          "rto challan",
          "e-challan pending",
          "wedding invitation.apk",
          "install this app to pay",
          "pm kisan.apk"
        ],
        "weak": [
          "install",
          "download",
          "invitation",
          "file",
          "app"
        ]
      },
      "min_weak": 3,
      "news_query": "APK file WhatsApp challan scam",
      "advice": {
        "verdict": "Government departments and banks never send app files on WhatsApp. Don't install it.",
        "steps": [
          "Delete the file without opening it.",
          "If you installed it, turn on airplane mode, uninstall it, and change your banking passwords from another device.",
          "Check real challans only on echallan.parivahan.gov.in.",
          "If money was taken, call 1930."
        ],
        "helplines": [
          "1930"
        ]
      },
      "sources": [
        "https://echallan.parivahan.gov.in",
        "https://www.cert-in.org.in"
      ],
      "_file": "apk-file"
    },
    {
      "id": "digital-arrest",
      "name": "Digital arrest",
      "summary": "Callers pose as CBI, customs, police or a court, claim a parcel or SIM in your name is linked to a crime, keep you on a video call and demand money to \"clear\" your name.",
      "points": 30,
      "phrases": {
        "strong": [
          "digital arrest",
          "digitally arrested",
          "डिजिटल अरेस्ट",
          "parcel contains drugs",
          "parcel with drugs",
          "money laundering case against you",
          "arrest warrant in your name",
          "stay on video call",
          "do not disconnect the call",
          "verification of your funds"
        ],
        "weak": [
          "cbi",
          "ncb",
          "customs",
          "cyber crime branch",
          "mumbai police",
          "fedex",
          "dhl",
          "parcel",
          "aadhaar",
          "warrant",
          "skype",
          "video call",
          "rbi account",
          "secret",
          "don't tell anyone",
          "किसी को मत बताना"
        ]
      },
      "min_weak": 3,
      "news_query": "digital arrest scam police advisory",
      "advice": {
        "verdict": "No police or agency in India arrests anyone over a phone or video call. Hang up and don't pay.",
        "steps": [
          "Hang up and stop any screen sharing.",
          "Don't send money, OTPs, Aadhaar or bank details.",
          "If you already paid, call 1930 right away. Money reported quickly can often be frozen.",
          "File a complaint at cybercrime.gov.in with the numbers and screenshots."
        ],
        "helplines": [
          "1930"
        ]
      },
      "sources": [
        "https://cybercrime.gov.in",
        "https://www.pib.gov.in"
      ],
      "_file": "digital-arrest"
    },
    {
      "id": "electricity-cutoff",
      "name": "Electricity disconnection",
      "summary": "An SMS says your power will be cut tonight because the last bill wasn't updated and asks you to call an \"electricity officer\", who then gets you to install a remote-access app or pay.",
      "points": 25,
      "phrases": {
        "strong": [
          "electricity will be disconnected",
          "power will be disconnected tonight",
          "your electricity connection will be cut",
          "previous month bill was not updated",
          "contact electricity officer",
          "बिजली कनेक्शन काट दिया जाएगा"
        ],
        "weak": [
          "electricity",
          "bijli",
          "disconnected",
          "tonight",
          "9.30 pm",
          "bill",
          "officer",
          "call immediately",
          "dear consumer"
        ]
      },
      "min_weak": 3,
      "news_query": "electricity bill disconnection SMS scam",
      "advice": {
        "verdict": "Power companies don't send disconnection threats with a personal mobile number. Don't call it.",
        "steps": [
          "Don't call the number and don't install any app they suggest (AnyDesk, TeamViewer, \"bill update\" APKs).",
          "Check your bill on your power company's official app or website.",
          "If you installed something or paid, call 1930."
        ],
        "helplines": [
          "1930"
        ]
      },
      "sources": [
        "https://cybercrime.gov.in"
      ],
      "_file": "electricity-cutoff"
    },
    {
      "id": "fake-challan",
      "name": "Fake e-challan",
